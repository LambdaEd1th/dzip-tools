{
  "name": "Dzip Archive",
  "id": "dev.lambdaedith.dzip",
  "version": "0.5.0",
  "build": 1,
  "nsh": "=0.7.1",
  "rust": ".",
  "root": "App",
  "web": { "host": "web/log-host.js" },
